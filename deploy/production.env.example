# Install privately as /etc/sim-training.env (mode 600); never commit the real file.
DJANGO_SETTINGS_MODULE=pilot_logbook.settings_production
SECRET_KEY=REPLACE_WITH_THE_EXISTING_PRODUCTION_SECRET_KEY
ALLOWED_HOSTS=survey-ebt.ru
CSRF_TRUSTED_ORIGINS=https://survey-ebt.ru
DB_NAME=sim_training
DB_USER=sim_training
DB_PASSWORD=REPLACE_WITH_NEW_DATABASE_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432
MEDIA_ROOT=/srv/sim-training/shared/media
STATIC_ROOT=/srv/sim-training/shared/staticfiles
SECURE_HSTS_SECONDS=3600

# Optional read-only ATCD integration; use the same random secret on both servers.
ATCD_BASE_URL=https://nordstar.atcdocs.ru
ATCD_EXPORT_KEY=
